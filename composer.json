{
    "name": "justbetter/statamic-veto",
    "description": "Statamic addon for blacklisting permissions.",
    "require": {
        "statamic/cms": "^6.0",
        "laravel/framework": "^13.0",
        "php": "^8.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.4",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^3.7",
        "phpstan/phpstan-mockery": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "JustBetter\\Veto\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JustBetter\\Veto\\Tests\\": "tests"
        }
    },
    "extra": {
        "statamic": {
            "name": "Statamic Veto",
            "description": "Statamic addon for blacklisting permissions."
        },
        "laravel": {
            "providers": [
                "JustBetter\\Veto\\ServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan --memory-limit=1G",
        "style": "pint --test",
        "style:fix": "pint",
        "coverage": "XDEBUG_MODE=coverage php vendor/bin/pest --coverage --min=100",
        "quality": [
            "@test",
            "@analyse",
            "@style"
        ]
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
